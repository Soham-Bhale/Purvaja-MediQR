# =============================================================================
# MediQR Enterprise Hospital Appliance Configuration
# Distributed Healthcare Archive & Consortium Blockchain Node
# =============================================================================

# 1. Hospital Organization Metadata
HOSPITAL_NODE_ID=HOSPITAL-APOLLO-01
HOSPITAL_NAME=Apollo Speciality Hospital
HOSPITAL_LICENSE_ID=MOH-GOV-DEL-9841
HOSPITAL_NODE_PORT=5001

# 2. Blockchain Consortium Connectivity (Zero Gas EVM)
CONSORTIUM_RPC_URL=http://localhost:8545
CONSORTIUM_LEDGER_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
HOSPITAL_ADMIN_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# 3. Cryptographic Storage Engine Keys (AES-256-GCM)
# Must be 32 bytes (64 hexadecimal characters) sourced from an enterprise HSM or Vault
AES_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_MASTER_PEPPER=mediqr-enterprise-secure-pepper-v2

# 4. Network Security & TLS
TLS_ENABLED=true
TLS_CERT_PATH=./certs/hospital-node.crt
TLS_KEY_PATH=./certs/hospital-node.key
CORS_ORIGIN=http://localhost:3000,https://portal.mediqr.org
